+@pytest.mark.asyncio
+async def test_server_budget_reservation_is_reentrant_within_one_task(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    monkeypatch.setenv("UNIGROK_LOCAL_DAILY_BUDGET_USD", "1")
+    store = PublicStateStore(tmp_path / "budget.db")
+    monkeypatch.setattr(server, "STATE", store)
+    server._ACTIVE_CALLER_BUDGET_RESERVATION.set(None)
+
+    outer = await server._begin_caller_budget_reservation()
+    inner = await server._begin_caller_budget_reservation()
+
+    assert outer.store is store
+    assert inner.store is None
+    await server._settle_budget_success(inner, {"cost_usd": 0.0})
+    assert (await store.get_local_budget_status(1.0))["status"] == "busy"
+    assert server._ACTIVE_CALLER_BUDGET_RESERVATION.get() is outer
+
+    await server._settle_budget_success(outer, {"cost_usd": 0.4})
+    assert server._ACTIVE_CALLER_BUDGET_RESERVATION.get() is None
+    replacement = await server._begin_caller_budget_reservation()
+    assert replacement.store is store
+    await server._settle_budget_success(replacement, {"cost_usd": 0.1})
+
+
+@pytest.mark.asyncio
+async def test_open_breaker_does_not_strand_local_budget_reservation(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    monkeypatch.setenv("UNIGROK_LOCAL_DAILY_BUDGET_USD", "1")
+    store = PublicStateStore(tmp_path / "budget.db")
+    monkeypatch.setattr(server, "STATE", store)
+    server._ACTIVE_CALLER_BUDGET_RESERVATION.set(None)
+    called = False
+
+    def reject(_plane: str, _model: str | None) -> server._BreakerAdmission:
+        raise RuntimeError("circuit breaker open")
+
+    async def operation() -> dict[str, object]:
+        nonlocal called
+        called = True
+        return {"cost_usd": 0.0}
+
+    monkeypatch.setattr(server, "_breaker_before_call", reject)
+
+    with pytest.raises(RuntimeError, match="circuit breaker open"):
+        await server._guarded_provider_call("api", "grok-test", operation)
+
+    assert called is False
+    assert (await store.get_local_budget_status(1.0))["status"] == "ready"
+    reservation = await server._begin_caller_budget_reservation()
+    assert reservation.store is store
+    await server._settle_budget_success(reservation, {"cost_usd": 0.0})
+
