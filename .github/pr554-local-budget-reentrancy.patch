+@pytest.mark.asyncio
+async def test_metered_durable_job_reuses_outer_budget_reservation(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    monkeypatch.setenv("UNIGROK_LOCAL_DAILY_BUDGET_USD", "1")
+    store = PublicStateStore(tmp_path / "budget.db")
+    monkeypatch.setattr(server, "STATE", store)
+    monkeypatch.setattr(server, "_CIRCUIT_BREAKERS", {})
+    server._ACTIVE_CALLER_BUDGET_RESERVATION.set(None)
+    calls = 0
+
+    async def operation() -> dict[str, object]:
+        nonlocal calls
+        calls += 1
+        return {
+            "status": "complete",
+            "text": "ok",
+            "plane": "api",
+            "resolved_plane": "api",
+            "cost_usd": 0.25,
+        }
+
+    async def produce() -> dict[str, object]:
+        return await server._guarded_provider_call("api", "grok-test", operation)
+
+    result = await server._run_durable_job(
+        produce,
+        ctx=None,
+        kind="web_search",
+        sync_window=5.0,
+    )
+
+    assert result["status"] == "complete"
+    assert calls == 1
+    status = await store.get_local_budget_status(1.0)
+    assert status["status"] == "ready"
+    assert status["spent_usd"] == pytest.approx(0.25)
+    assert server._ACTIVE_CALLER_BUDGET_RESERVATION.get() is None
