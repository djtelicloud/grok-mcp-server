+def _release_oauth_introspection_task(
+    key: tuple[int, str, bytes, str], task: asyncio.Task[OAuthIntrospectionResult]
+) -> None:
+    if _OAUTH_INTROSPECTION_INFLIGHT.get(key) is task:
+        _OAUTH_INTROSPECTION_INFLIGHT.pop(key, None)
+    if not task.cancelled():
+        _ = task.exception()
+
