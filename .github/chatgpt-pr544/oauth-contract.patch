+async def introspect_oauth_token(
+    token: str, required: str
+) -> OAuthIntrospectionResult:
+    url = introspection_url()
+    if not url or not token or len(token) > 8_192:
+        return _OAUTH_DENIED
+    loop = asyncio.get_running_loop()
+    key = (id(loop), url, hashlib.sha256(token.encode("utf-8")).digest(), required)
+    task = _OAUTH_INTROSPECTION_INFLIGHT.get(key)
+    if task is None:
+        task = loop.create_task(_introspect_oauth_token_once(url, token, required))
+        _OAUTH_INTROSPECTION_INFLIGHT[key] = task
+        task.add_done_callback(
+            lambda completed, current_key=key: _release_oauth_introspection_task(
+                current_key, completed
+            )
+        )
+    return await asyncio.shield(task)
 
 
