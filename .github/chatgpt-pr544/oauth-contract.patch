+async def test_oauth_control_outage_is_retryable(
+    remote_oauth_env: None, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    class Client:
+        async def __aenter__(self) -> Client:
+            return self
+
+        async def __aexit__(self, *_args: Any) -> None:
+            return None
+
+        async def post(self, *_args: Any, **_kwargs: Any) -> Any:
+            raise httpx.ConnectError("control unavailable")
+
+    monkeypatch.setattr(remote_auth.httpx, "AsyncClient", lambda **_kwargs: Client())
+
+    async def downstream(scope: dict[str, Any], receive: Any, send: Any) -> None:
+        raise AssertionError("unverified request reached the application")
+
+    status, headers, response_body = await _asgi_exchange(
+        remote_auth.RemoteOAuthMiddleware(downstream),
+        path="/v1/models",
+        headers=((b"authorization", b"Bearer opaque-token"),),
+    )
+
+    assert status == 503
+    assert json.loads(response_body) == {"error": "oauth_temporarily_unavailable"}
+    assert headers["retry-after"] == "1"
+    assert headers["cache-control"] == "no-store"
+    assert "www-authenticate" not in headers
+
+
+async def test_oauth_control_outage_is_coalesced(
+    remote_oauth_env: None, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    started = asyncio.Event()
+    release = asyncio.Event()
+    calls = 0
+
+    class Client:
+        async def __aenter__(self) -> Client:
+            return self
+
+        async def __aexit__(self, *_args: Any) -> None:
+            return None
+
+        async def post(self, *_args: Any, **_kwargs: Any) -> Any:
+            nonlocal calls
+            calls += 1
+            started.set()
+            await release.wait()
+            raise httpx.ConnectError("control unavailable")
+
+    monkeypatch.setattr(remote_auth.httpx, "AsyncClient", lambda **_kwargs: Client())
+
+    async def downstream(scope: dict[str, Any], receive: Any, send: Any) -> None:
+        raise AssertionError("unverified request reached the application")
+
+    app = remote_auth.RemoteOAuthMiddleware(downstream)
+    request = {
+        "path": "/v1/models",
+        "headers": ((b"authorization", b"Bearer shared-token"),),
+    }
+    first = asyncio.create_task(_asgi_exchange(app, **request))
+    await asyncio.wait_for(started.wait(), timeout=1)
+    second = asyncio.create_task(_asgi_exchange(app, **request))
+    await asyncio.sleep(0.01)
+    release.set()
+    responses = await asyncio.gather(first, second)
+
+    assert calls == 1
+    assert [response[0] for response in responses] == [503, 503]
+    assert [json.loads(response[2]) for response in responses] == [
+        {"error": "oauth_temporarily_unavailable"},
+        {"error": "oauth_temporarily_unavailable"},
+    ]
+
+
+async def test_oauth_control_outage_survives_cancelled_leader(
+    remote_oauth_env: None, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    started = asyncio.Event()
+    release = asyncio.Event()
+    calls = 0
+
+    class Client:
+        async def __aenter__(self) -> Client:
+            return self
+
+        async def __aexit__(self, *_args: Any) -> None:
+            return None
+
+        async def post(self, *_args: Any, **_kwargs: Any) -> Any:
+            nonlocal calls
+            calls += 1
+            started.set()
+            await release.wait()
+            raise httpx.ConnectError("control unavailable")
+
+    monkeypatch.setattr(remote_auth.httpx, "AsyncClient", lambda **_kwargs: Client())
+
+    async def downstream(scope: dict[str, Any], receive: Any, send: Any) -> None:
+        raise AssertionError("unverified request reached the application")
+
+    app = remote_auth.RemoteOAuthMiddleware(downstream)
+    request = {
+        "path": "/v1/models",
+        "headers": ((b"authorization", b"Bearer shared-token"),),
+    }
+    leader = asyncio.create_task(_asgi_exchange(app, **request))
+    await asyncio.wait_for(started.wait(), timeout=1)
+    leader.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await leader
+    follower = asyncio.create_task(_asgi_exchange(app, **request))
+    await asyncio.sleep(0.01)
+    release.set()
+    status, _, response_body = await follower
+
+    assert calls == 1
+    assert status == 503
+    assert json.loads(response_body) == {"error": "oauth_temporarily_unavailable"}
+
