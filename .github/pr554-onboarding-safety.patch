diff --git a/tests/test_onboarding_safe_mode.py b/tests/test_onboarding_safe_mode.py
new file mode 100644
index 0000000..bf58c73
--- /dev/null
+++ b/tests/test_onboarding_safe_mode.py
@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from unigrok_public import server
+
+
+@pytest.fixture(autouse=True)
+def _local_runtime(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("UNIGROK_RUNTIME", raising=False)
+    monkeypatch.delenv("UNIGROK_PUBLIC_MCP_URL", raising=False)
+
+
+def _run_cursor_hook(tmp_path: Path, payload: object) -> dict[str, str]:
+    hook = tmp_path / "hook.py"
+    hook.write_text(server.CURSOR_AGENT_HOOK, encoding="utf-8")
+    completed = subprocess.run(
+        [sys.executable, str(hook)],
+        input=json.dumps(payload),
+        text=True,
+        capture_output=True,
+        check=True,
+    )
+    return json.loads(completed.stdout)
+
+
+def test_cursor_hook_fails_closed_for_empty_or_ambiguous_tools(tmp_path: Path) -> None:
+    assert _run_cursor_hook(tmp_path, {}) == {"permission": "ask"}
+    assert _run_cursor_hook(tmp_path, {"tool_name": "agent-shell"}) == {
+        "permission": "ask"
+    }
+    assert _run_cursor_hook(tmp_path, {"tool_name": "agent"}) == {
+        "permission": "allow"
+    }
+    assert _run_cursor_hook(tmp_path, {"toolName": "mcp__grok__agent_result"}) == {
+        "permission": "allow"
+    }
+
+
+@pytest.mark.parametrize("scope", ["global", "project"])
+def test_cursor_safe_mode_omits_automatic_hook(scope: str) -> None:
+    plan = server._client_onboarding_plan("cursor", scope, safe_mode=True)
+
+    assert plan["safe_mode"] is True
+    assert plan["automatic_tool_approval_offered"] is False
+    assert "hooks" not in plan
+    assert "safe_mode_note" in plan
+    assert all(
+        not item["path"].endswith("before-unigrok-agent.py")
+        for item in plan["files"]
+    )
+
+
+@pytest.mark.parametrize("client", sorted(server.CLIENT_ADAPTERS))
+def test_safe_mode_never_emits_auto_approval(client: str) -> None:
+    plan = server._client_onboarding_plan(client, "global", safe_mode=True)
+
+    assert plan["safe_mode"] is True
+    assert plan["automatic_tool_approval_offered"] is False
+    assert "auto_approve" not in plan
+    assert "hooks" not in plan
+
+
+def test_antigravity_whole_server_trust_is_explicitly_high_risk() -> None:
+    alternative = server._auto_approve("antigravity", "global")[
+        "gemini_cli_alternative"
+    ]
+
+    assert alternative["whole_server_trust"] is True
+    assert alternative["risk"] == "high"
+    assert "metered" in alternative["note"].lower()
